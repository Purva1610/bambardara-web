# Copy this file to .env and fill in your Firebase project values.
# These are baked into the JS bundle at build time by react-scripts.
# Never commit .env to source control.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Optional: URL of a JSON POST endpoint for the enquiry form.
# When left blank the form opens a pre-filled mailto: link instead.
REACT_APP_ENQUIRY_ENDPOINT=
