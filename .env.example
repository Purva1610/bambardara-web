# Copy this file to .env for local development.
# Vite only exposes VITE_-prefixed vars, via import.meta.env (not process.env).
# Never commit .env to source control.

# --- Keycloak (Direct Grant flow, local-dev phase) ---
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=bambardara
VITE_KEYCLOAK_CLIENT_ID=bambardara-web

# --- Backend API ---
VITE_API_BASE_URL=http://localhost:8080

# Optional: URL of a JSON POST endpoint for the enquiry form.
# When left blank the form opens a pre-filled mailto: link instead.
VITE_ENQUIRY_ENDPOINT=
