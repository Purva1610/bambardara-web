# Copy to .env (or export these into your shell) for local development.
# Never commit an actual .env file or real secrets.

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/bambardara
SPRING_DATASOURCE_USERNAME=bambardara
SPRING_DATASOURCE_PASSWORD=bambardara_dev

# --- Keycloak / OAuth2 Resource Server ---
# Leave blank to run without Keycloak configured - KeycloakResourceServerConfig
# simply does not build a JWT decoder in that case, so nothing breaks.
# Point this at a local Keycloak instance's realm issuer once one is running,
# e.g. a "bambardara" realm on a Keycloak dev server at localhost:8081:
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/bambardara

# Admin API credentials used by KeycloakAdminService to create a user's
# Keycloak identity during POST /api/auth/register. Must be a confidential
# client with serviceAccountsEnabled=true and the realm-management
# "manage-users" role granted to its service account (bambardara-api in
# keycloak/realm-export/bambardara-realm.json already has both).
KEYCLOAK_ADMIN_CLIENT_ID=bambardara-api
KEYCLOAK_ADMIN_CLIENT_SECRET=bambardara-api-dev-secret-CHANGE-ME

# --- Legacy local JWT (existing, being migrated away from)---
# Must be Base64 and decode to at least 32 bytes.
APP_JWT_SECRET=
APP_JWT_EXPIRY_MINUTES=1440

# --- Mail (contact-us notifications, password reset OTP) ---
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=
APP_MAIL_MARKETING_TEAM=
