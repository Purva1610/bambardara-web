# Copy this file to .env for local development.
# These are baked into the JS bundle at build time by react-scripts.
# Never commit .env to source control.

# --- Keycloak (Direct Grant flow, local-dev phase) ---
REACT_APP_KEYCLOAK_URL=http://localhost:8081
REACT_APP_KEYCLOAK_REALM=bambardara
REACT_APP_KEYCLOAK_CLIENT_ID=bambardara-web

# --- Backend API ---
REACT_APP_API_URL=http://localhost:8080

# Optional: URL of a JSON POST endpoint for the enquiry form.
# When left blank the form opens a pre-filled mailto: link instead.
REACT_APP_ENQUIRY_ENDPOINT=
