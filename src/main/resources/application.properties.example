spring.application.name=demo

spring.datasource.url=jdbc:postgresql://127.0.0.1:5433/bambardara
spring.datasource.username=bambardara
spring.datasource.password=bambardara_dev

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# Origins allowed to call /api/** (the React dev server)
app.cors.allowed-origins=http://localhost:3000

spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=abhayepay@gmail.com
spring.mail.password=dhipmhesytbhrpyb

spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Bail out instead of hanging the async mail thread on an unresponsive SMTP host
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000

# JWT signing. Dev-only value: replace with an environment variable before
# deploying, and rotating it invalidates every token already issued.
# Must be Base64 and at least 32 bytes once decoded, or startup fails.
app.jwt.secret=UUcxK/BUhE1pZDcILTyjn4bFzcSWUS9WdTJ6WR25bozfGz3iHvNEi7EbAwgNIh/z2V7FCvZ9ArySjjNsW29BlA==
app.jwt.expiry-minutes=1440

# Contact-us notifications
# Gmail rewrites the From header to the authenticated account, so keep these
# in sync with spring.mail.username.
app.mail.from=abhayepay@gmail.com
# Comma-separated; every address here is notified about a new concern.
app.mail.marketing-team=abhayepay@gmail.com

# Google OAuth2 Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
# Create OAuth 2.0 Client ID and add authorized redirect URI: {your-backend-url}/login/oauth2/code/google
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID:your-client-id-from-google-console}
spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET:your-client-secret-from-google-console}
spring.security.oauth2.client.registration.google.scope=openid,profile,email
spring.security.oauth2.client.registration.google.redirect-uri={baseUrl}/login/oauth2/code/google

# OAuth Success Redirect (frontend callback URL where authorization code will be sent)
# Local: http://localhost:3000/auth/callback
# Production: https://yourdomain.com/auth/callback
app.oauth.frontend-callback-url=${FRONTEND_CALLBACK_URL:http://localhost:3000/auth/callback}
