# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Never include local env secrets in the image build context.
# Pass Firebase credentials via --build-arg or docker-compose args instead.
.env
.env.local
.env.*.local

# Camera originals — only the optimised derivatives in opt/ are served
public/images/*.jpg
public/images/*.jpeg

# Testing
coverage/
.nyc_output/

# Production build (will be created during Docker build)
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Misc
.eslintcache
tmp/
temp/
