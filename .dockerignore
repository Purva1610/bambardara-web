# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Never include local env secrets in the image build context.
# Pass Keycloak config via --build-arg or docker-compose args instead.
.env
.env.local
.env.*.local

# Camera originals — only the optimised derivatives in opt/ are served
public/images/*.jpg
public/images/*.jpeg
public/images/*.png
public/images/*.webp

# Large raw video originals — only the compressed web versions are served
public/videos/dairy.mp4
public/videos/RAPELLING.mp4

# Testing
coverage/
.nyc_output/

# Production build (will be created during Docker build)
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Agent & Dev tooling
.agents/
.claude/
.gemini/
.kilo/
scratch/
screenshots/
*.md
!README.md

# Misc
.eslintcache
tmp/
temp/
scripts/temp_dishes/
*.txt

